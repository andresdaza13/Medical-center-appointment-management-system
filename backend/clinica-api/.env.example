# Copia este archivo como backend/clinica-api/.env
# Debe coincidir con los valores del .env de la raíz (docker-compose).

PORT=3000
DATABASE_URL=postgresql://piedrazul:cambia-esta-clave@localhost:5432/piedrazul?schema=public

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Keycloak: emisor de los tokens y audiencia que esta API exige
KEYCLOAK_ISSUER=http://localhost:8080/realms/piedrazul
KEYCLOAK_AUDIENCE=piedrazul-api

# Zona horaria del negocio (define qué es "hoy" para el agendamiento)
APP_TIMEZONE=America/Bogota
