                }
              ]
            }
          }
        },
        {
          "name": "RF2 · Agendar (personal)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{api}}/citas"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicoId\": 1,\n  \"fecha\": \"2026-11-04\",\n  \"hora\": \"07:05\",\n  \"pacienteId\": 1,\n  \"observacion\": \"Control\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancelar cita",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{api}}/citas/1/cancelar"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "RF3 · Ventana de agendamiento",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{api}}/configuracion"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ventanaSemanas\": 6\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "RF3 · Horario del médico",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{api}}/medicos/1/horario"
