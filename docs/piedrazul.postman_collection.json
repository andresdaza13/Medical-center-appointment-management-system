{
  "info": {
    "name": "Piedrazul - API y Keycloak",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de la API de Piedrazul y gestión de usuarios/roles con la API de administración de Keycloak (RNF1). Solo para desarrollo."
  },
  "variable": [
    {
      "key": "api",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "kc",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "agendador1"
    },
    {
      "key": "password",
      "value": "Piedrazul2026"
    },
    {
      "key": "kcAdmin",
      "value": "admin"
    },
    {
      "key": "kcAdminPassword",
      "value": "cambia-esta-clave"
    },
    {
      "key": "nuevoUsuario",
      "value": "medico2"
    },
    {
      "key": "rol",
      "value": "medico"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "roleJson",
      "value": "[]"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "1. Token de usuario (password grant)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{kc}}/realms/piedrazul/protocol/openid-connect/token"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "piedrazul-postman",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            },
            "description": "Cambie las variables username/password para probar cada rol. El token se guarda en {{userToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const t = pm.response.json().access_token;",
                  "pm.collectionVariables.set('userToken', t);",
                  "pm.test('token recibido', () => pm.expect(t).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil según el token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/auth/perfil"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Gestión de usuarios y roles (Keycloak Admin API)",
      "item": [
        {
          "name": "2.1 Token de administrador (realm master)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{kc}}/realms/master/protocol/openid-connect/token"
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "admin-cli",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{kcAdmin}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{kcAdminPassword}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Crear usuario",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/users"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{nuevoUsuario}}\",\n  \"email\": \"{{nuevoUsuario}}@piedrazul.test\",\n  \"firstName\": \"Nuevo\",\n  \"lastName\": \"Profesional\",\n  \"enabled\": true,\n  \"emailVerified\": true,\n  \"credentials\": [\n    {\n      \"type\": \"password\",\n      \"value\": \"Piedrazul2026\",\n      \"temporary\": true\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "temporary=true obliga al usuario a cambiar la contraseña en su primer inicio de sesión."
          }
        },
        {
          "name": "2.3 Buscar id del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/users?username={{nuevoUsuario}}&exact=true"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const u = pm.response.json()[0];",
                  "pm.collectionVariables.set('userId', u.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Obtener el rol",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/roles/{{rol}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Roles válidos: administrador, agendador, medico, paciente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('roleJson', JSON.stringify([pm.response.json()]));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Asignar rol al usuario",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/users/{{userId}}/role-mappings/realm"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{roleJson}}"
            }
          }
        },
        {
          "name": "2.6 Ver roles del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/users/{{userId}}/role-mappings/realm"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2.7 Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/users?max=50"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "2.8 Desactivar usuario",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{kc}}/admin/realms/piedrazul/users/{{userId}}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. API Piedrazul",
      "item": [
        {
          "name": "Médicos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/medicos"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "RF1 · Agenda del día",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/citas?medicoId=1&fecha=2026-11-04"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "RF2 · Disponibilidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/citas/disponibilidad?medicoId=1&fecha=2026-11-04"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "RF2 · Sugerencias por especialidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/citas/sugerencias?especialidad=TERAPIA_NEURAL&limite=5"
