              "raw": "{{api}}/pacientes/buscar?documento=106"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "RF5 · Historial por cédula",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/citas/historial?documento=1061000001"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
