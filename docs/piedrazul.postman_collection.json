              "raw": "{\n  \"documento\": \"1061000099\",\n  \"nombres\": \"Héctor\",\n  \"apellidos\": \"Bojorge\",\n  \"celular\": \"3101234567\",\n  \"genero\": \"HOMBRE\",\n  \"fechaNacimiento\": \"1970-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "4. Pruebas de seguridad (esperar 400/401/403)",
      "item": [
        {
          "name": "Sin token → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api}}/citas?medicoId=1&fecha=2026-11-04"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Mass assignment → 400",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{api}}/pacientes"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documento\": \"1061000098\",\n  \"nombres\": \"X\",\n  \"apellidos\": \"Y\",\n  \"celular\": \"3101234567\",\n  \"genero\": \"OTRO\",\n  \"keycloakId\": \"robado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Paciente configura → 403 (use token de paciente1)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{api}}/configuracion"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ventanaSemanas\": 26\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}